# Public, canonical URL without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend-compatible transactional email API.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=Strefa 29 <formularz@twoja-domena.pl>

# Used only to hash rate-limit keys. Generate a long random value in production.
RATE_LIMIT_SALT=

# Optional override for the map query.
NEXT_PUBLIC_MAP_QUERY=Żurawia 29, 80-298 Czaple

# Indexing stays off until the owner approves public company data and an https origin.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Set true only behind a reverse proxy that overwrites X-Forwarded-For / X-Real-IP.
RATE_LIMIT_TRUST_PROXY=

# Optional shared rate limit. Without both values the app uses in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email provider timeout in milliseconds.
INQUIRY_DELIVERY_TIMEOUT_MS=10000

# PostgreSQL connection string for the staff panel. Never commit a real value.
DATABASE_URL=

# Better Auth session secret. Generate at least 32 random characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# One-time secret used to create the first owner. Remove it after that account exists.
STAFF_BOOTSTRAP_TOKEN=

# Secret for notification retries and the retention job. At least 32 characters.
NOTIFICATION_WORKER_TOKEN=

# Leave empty until the owner approves a retention period. The purge then deletes nothing.
DATA_RETENTION_DAYS=

# Tests may set this to "memory". Production must leave it empty and use DATABASE_URL.
INQUIRY_STORE=
