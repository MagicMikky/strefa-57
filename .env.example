# Public, canonical URL without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend-compatible transactional email API.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=Strefa 29 <formularz@twoja-domena.pl>

# Used only to hash rate-limit keys. Generate a long random value in production.
RATE_LIMIT_SALT=

# Optional override for the map query.
NEXT_PUBLIC_MAP_QUERY=Żurawia 29, 80-298 Czaple

# Indexing stays off until the owner approves public company data and an https origin.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Set true only behind a reverse proxy that overwrites X-Forwarded-For / X-Real-IP.
RATE_LIMIT_TRUST_PROXY=

# Optional shared rate limit. Without both values the app uses in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email provider timeout in milliseconds.
INQUIRY_DELIVERY_TIMEOUT_MS=10000
